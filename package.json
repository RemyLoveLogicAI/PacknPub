{
  "name": "packnpub",
  "version": "2.0.0",
  "description": "Add a production-grade release pipeline (npm, GitHub Releases, GitHub Packages, Homebrew) to any Node package with one command",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemyLoveLogicAI/PacknPub.git"
  },
  "homepage": "https://github.com/RemyLoveLogicAI/PacknPub#readme",
  "bugs": "https://github.com/RemyLoveLogicAI/PacknPub/issues",
  "keywords": [
    "npm",
    "publish",
    "release",
    "homebrew",
    "github-actions",
    "trusted-publishing",
    "cli"
  ],
  "bin": {
    "packnpub": "./bin/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "verify": "npm run build && node bin/cli.js verify",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run check:pkg"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^22.0.0",
    "publint": "^0.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
